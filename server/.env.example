# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# must never be committed. Never share production credentials.

# Required in every environment. The backend only supports PostgreSQL.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional. Override the insecure dev fallback with a long random string, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
# Required when DJANGO_DEBUG=False.
# DJANGO_SECRET_KEY=

# Optional. Defaults to True (development). Set to False in production.
# DJANGO_DEBUG=False

# Required when DJANGO_DEBUG=False. Comma or space separated list of allowed
# hostnames (REST + WebSocket origin validation), e.g. "api.example.com".
# DJANGO_ALLOWED_HOSTS=

# Optional. Redis channel layer for multiple ASGI workers.
# REDIS_URL=redis://localhost:6379/0